pipeline {
    agent any

    environment {
        DOCKER_HUB_CREDENTIALS = credentials('docker-hub-credentials')
        DOCKER_IMAGE_FRONTEND = 'zomato-frontend'
        DOCKER_IMAGE_BACKEND = 'zomato-backend'
        DOCKER_REGISTRY = "${params.DOCKER_REGISTRY ?: 'your-dockerhub-username'}"
    }

    parameters {
        string(name: 'DOCKER_REGISTRY', defaultValue: 'your-dockerhub-username', description: 'Docker Hub username/registry')
        choice(name: 'DEPLOY_ENV', choices: ['staging', 'production'], description: 'Deployment environment')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            parallel {
                stage('Frontend Dependencies') {
                    steps {
                        dir('frontend') {
                            bat 'npm install'
                        }
                    }
                }
                stage('Backend Dependencies') {
                    steps {
                        dir('backend') {
                            bat 'npm install'
                        }
                    }
                }
                stage('Root Dependencies') {
                    steps {
                        bat 'npm install'
                    }
                }
            }
        }

        stage('Lint and Test') {
            parallel {
                stage('Frontend Lint') {
                    steps {
                        dir('frontend') {
                            bat 'npm run lint || echo "No lint script"'
                        }
                    }
                }
                stage('Backend Lint') {
                    steps {
                        dir('backend') {
                            bat 'npm run lint || echo "No lint script"'
                        }
                    }
                }
                stage('Frontend Test') {
                    steps {
                        dir('frontend') {
                            bat 'npm test -- --watchAll=false --passWithNoTests || echo "No tests"'
                        }
                    }
                }
                stage('Backend Test') {
                    steps {
                        dir('backend') {
                            bat 'npm test -- --watchAll=false --passWithNoTests || echo "No tests"'
                        }
                    }
                }
            }
        }

        stage('Build') {
            parallel {
                stage('Build Frontend') {
                    steps {
                        bat 'npm run build'
                    }
                }
                stage('Build Backend') {
                    steps {
                        dir('backend') {
                            bat 'npm run build || echo "No build script"'
                        }
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    bat "docker build -t ${DOCKER_REGISTRY}/${DOCKER_IMAGE_FRONTEND}:${BUILD_NUMBER} ."
                    bat "docker build -t ${DOCKER_REGISTRY}/${DOCKER_IMAGE_FRONTEND}:latest ."
                    dir('backend') {
                        bat "docker build -t ${DOCKER_REGISTRY}/${DOCKER_IMAGE_BACKEND}:${BUILD_NUMBER} ."
                        bat "docker build -t ${DOCKER_REGISTRY}/${DOCKER_IMAGE_BACKEND}:latest ."
                    }
                }
            }
        }

        stage('Push to Registry') {
            steps {
                script {
                    bat "echo %DOCKER_HUB_CREDENTIALS_PSW% | docker login -u %DOCKER_HUB_CREDENTIALS_USR% --password-stdin"
                    bat "docker push ${DOCKER_REGISTRY}/${DOCKER_IMAGE_FRONTEND}:${BUILD_NUMBER}"
                    bat "docker push ${DOCKER_REGISTRY}/${DOCKER_IMAGE_FRONTEND}:latest"
                    bat "docker push ${DOCKER_REGISTRY}/${DOCKER_IMAGE_BACKEND}:${BUILD_NUMBER}"
                    bat "docker push ${DOCKER_REGISTRY}/${DOCKER_IMAGE_BACKEND}:latest"
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    if (params.DEPLOY_ENV == 'production') {
                        bat 'docker-compose -f docker-compose.prod.yml down || echo "No running containers"'
                        bat 'docker-compose -f docker-compose.prod.yml up -d'
                    } else {
                        bat 'docker-compose down || echo "No running containers"'
                        bat 'docker-compose up -d'
                    }
                }
            }
        }
    }

    post {
        always {
            bat 'docker logout || echo "Not logged in"'
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
