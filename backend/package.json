{
  "name": "zomato-clone-backend",
  "version": "1.0.0",
  "description": "Security-hardened Zomato clone backend",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "jest --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dayjs": "1.11.10",
    "dompurify": "^3.4.2",
    "dotenv": "16.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "7.1.5",
    "express-validator": "7.0.1",
    "helmet": "7.1.0",
    "isomorphic-dompurify": "2.4.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "^8.23.1",
    "morgan": "^1.10.1",
    "pg": "8.11.3",
    "redis": "4.6.10",
    "uuid": "^14.0.0",
    "winston": "3.11.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.11",
    "@types/jsonwebtoken": "9.0.5",
    "@types/morgan": "1.9.9",
    "@types/node": "20.10.5",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "6.15.0",
    "@typescript-eslint/parser": "6.15.0",
    "eslint": "8.56.0",
    "eslint-plugin-security": "^4.0.0",
    "jest": "29.7.0",
    "ts-jest": "29.1.1",
    "tsx": "4.21.0",
    "typescript": "5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
